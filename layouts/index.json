{{- /* Zoekindex voor search.js. Per pagina (ook sectiepagina's) een item voor de
       pagina zelf en een item per h2, h3 en uitklapblok, met het anker erbij,
       zodat een zoekresultaat naar de juiste plek scrollt. Het zijn de
       gerenderde koppen, dus de ankers kloppen met de pagina en een regel met
       "## " in een codeblok wordt geen kop. Codeblokken zitten gewoon in de
       tekst van hun fragment. Een pagina met zoekindex: false in de front
       matter blijft er met haar koppen uit. Site-eigen items komen uit de
       hook search-index-extra.html, ook voor zo'n pagina. */ -}}
{{- $index := slice -}}

{{- define "partials/clean-content" -}}
  {{- $content := . -}}
  {{- /* De verborgen meldingen van render-link horen niet in de index. */ -}}
  {{- $content = replace $content " (opent in een nieuw venster)" "" -}}
  {{- $content = replace $content ", opent in een nieuw venster" "" -}}
  {{- $content = replace $content " (besloten omgeving)" "" -}}
  {{- /* De terugverwijzing in voetnoten is een pijl, geen tekst. De spatie
         ervoor is een niet-afbrekende (&nbsp;) en telt als gewone spatie. */ -}}
  {{- $content = replace $content "↩︎" "" -}}
  {{- $content = replace $content "↩" "" -}}
  {{- $content = replaceRE `[ \t\x{00a0}]+` " " $content -}}
  {{- $content = replaceRE `\s*\n\s*` "\n" $content -}}
  {{- return ($content | strings.TrimSpace) -}}
{{- end -}}

{{- /* plainify plakt tekst van aangrenzende blokken aan elkaar; zet er een
       regeleinde, of bij een cel een spatie, tussen. */ -}}
{{- define "partials/html-naar-tekst" -}}
  {{- $html := . -}}
  {{- $html = replaceRE `<li[^>]*>` "\n· " $html -}}
  {{- $html = replaceRE `</t[dh]>` " " $html -}}
  {{- $html = replaceRE `</(?:p|li|tr|div|dd|dt|h[1-6]|blockquote|summary|figcaption|table|ul|ol)>|<br\s*/?>` "\n" $html -}}
  {{- return (partial "clean-content" ($html | plainify | htmlUnescape)) -}}
{{- end -}}

{{- range where .Site.Pages "Kind" "in" (slice "page" "section") -}}
  {{- if and (not .Draft) .RelPermalink (ne .Params.zoekindex false) -}}
    {{- $pageTitle := .Title -}}
    {{- $pageUrl := .RelPermalink -}}
    {{- $pageSection := .Section -}}
    {{- $inhoud := partial "koppen-ids.html" .Content -}}
    {{- $stukken := split (replaceRE `<h([23]) id="` "|||KOP|||<h${1} id=\"" $inhoud) "|||KOP|||" -}}
    {{- $index = $index | append (dict "title" $pageTitle "url" $pageUrl "content" (partial "html-naar-tekst" (index $stukken 0)) "section" $pageSection) -}}
    {{- range $i, $stuk := $stukken -}}
      {{- if gt $i 0 -}}
        {{- $id := replaceRE `(?s)^<h[23] id="([^"]+)".*` "$1" $stuk -}}
        {{- $kop := $stuk | replaceRE `(?s)^<h[23][^>]*>(.*?)</h[23]>.*` "$1" | plainify | htmlUnescape | strings.TrimSpace -}}
        {{- $tekst := partial "html-naar-tekst" (replaceRE `(?s)^<h[23][^>]*>.*?</h[23]>` "" $stuk) -}}
        {{- /* Een kop met (bijna) geen eigen tekst, zoals een h2 direct voor een h3,
               blijft vindbaar op zijn titel; een korte tekst ("Ja.") blijft erachter. */ -}}
        {{- if le (len $tekst) 10 -}}{{- $tekst = strings.TrimSpace (printf "%s %s" $kop $tekst) -}}{{- end -}}
        {{- if $tekst -}}
          {{- $index = $index | append (dict "title" (printf "%s: %s" $pageTitle $kop) "url" (printf "%s#%s" $pageUrl $id) "content" $tekst "section" $pageSection) -}}
        {{- end -}}
      {{- end -}}
    {{- end -}}
    {{- /* Een uitklapblok heeft een summary, geen kop, maar mensen zoeken er wel op. */ -}}
    {{- range $blok := findRE `(?s)<details id="[^"]+"[^>]*>.*?</details>` $inhoud -}}
      {{- $id := replaceRE `(?s)^<details id="([^"]+)".*` "$1" $blok -}}
      {{- $kop := $blok | replaceRE `(?s)^.*?<summary[^>]*>(.*?)</summary>.*` "$1" | plainify | htmlUnescape | strings.TrimSpace -}}
      {{- $tekst := partial "html-naar-tekst" (replaceRE `(?s)<summary[^>]*>.*?</summary>` "" $blok) -}}
      {{- if le (len $tekst) 10 -}}{{- $tekst = strings.TrimSpace (printf "%s %s" $kop $tekst) -}}{{- end -}}
      {{- if $tekst -}}
        {{- $index = $index | append (dict "title" (printf "%s: %s" $pageTitle $kop) "url" (printf "%s#%s" $pageUrl $id) "content" $tekst "section" $pageSection) -}}
      {{- end -}}
    {{- end -}}
  {{- end -}}
{{- end -}}

{{- $extra := partial "search-index-extra.html" . -}}
{{- if reflect.IsSlice $extra -}}
  {{- $index = $index | append $extra -}}
{{- end -}}
{{ $index | jsonify }}
