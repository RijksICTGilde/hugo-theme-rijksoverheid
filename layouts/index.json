{{- /* Zoekindex voor search.js. Per pagina (ook sectiepagina's en de homepage) een item voor de
       pagina zelf en een item per h2, h3 en uitklapblok, met het anker erbij,
       zodat een zoekresultaat naar de juiste plek scrollt. Het zijn de
       gerenderde koppen, dus de ankers kloppen met de pagina en een regel met
       "## " in een codeblok wordt geen kop. Codeblokken zitten gewoon in de
       tekst van hun fragment. Een pagina met search_index: false in de front
       matter blijft er met haar koppen uit. Site-eigen items komen uit de
       hook search-index-extra.html, ook voor zo'n pagina.

       Een kaartengrid (card-grid) staat er niet in, want de pagina's erin
       staan er zelf al in; tegels (tiles) zijn inhoud en staan er wel in.
       Het item van de pagina zelf krijgt ook synonyms en de velden uit
       params.search.extra_fields. Een pagina buiten een sectie krijgt als
       sectie home (de homepage) of de naam van haar bestand, zodat
       params.search.priority_sections haar kan noemen. */ -}}
{{- $index := slice -}}
{{- $extraFields := slice -}}
{{- with site.Params.search.extra_fields }}{{ $extraFields = cond (reflect.IsSlice .) . (slice .) }}{{ end -}}

{{- define "partials/clean-content" -}}
  {{- $content := . -}}
  {{- /* De verborgen meldingen van render-link horen niet in de index. */ -}}
  {{- $content = replace $content " (opent in een nieuw venster)" "" -}}
  {{- $content = replace $content ", opent in een nieuw venster" "" -}}
  {{- $content = replace $content " (besloten omgeving)" "" -}}
  {{- /* De terugverwijzing in voetnoten is een pijl, geen tekst. De spatie
         ervoor is een niet-afbrekende (&nbsp;) en telt als gewone spatie. */ -}}
  {{- $content = replace $content "↩︎" "" -}}
  {{- $content = replace $content "↩" "" -}}
  {{- $content = replaceRE `[ \t\x{00a0}]+` " " $content -}}
  {{- $content = replaceRE `\s*\n\s*` "\n" $content -}}
  {{- return ($content | strings.TrimSpace) -}}
{{- end -}}

{{- /* plainify plakt tekst van aangrenzende blokken aan elkaar; zet er een
       regeleinde, of bij een cel een spatie, tussen. */ -}}
{{- define "partials/html-to-text" -}}
  {{- $html := . -}}
  {{- $html = replaceRE `<li[^>]*>` "\n· " $html -}}
  {{- $html = replaceRE `</t[dh]>` " " $html -}}
  {{- $html = replaceRE `</(?:p|li|tr|div|dd|dt|h[1-6]|blockquote|summary|figcaption|table|ul|ol)>|<br\s*/?>` "\n" $html -}}
  {{- return (partial "clean-content" ($html | plainify | htmlUnescape)) -}}
{{- end -}}

{{- /* Een waarde uit de front matter, een tekst of een lijst teksten met
       Markdown, als lijst platte teksten. */ -}}
{{- define "partials/front-matter-text" -}}
  {{- $texts := slice -}}
  {{- range cond (reflect.IsSlice .) . (slice .) -}}
    {{- with partial "html-to-text" (markdownify .) }}{{ $texts = $texts | append . }}{{ end -}}
  {{- end -}}
  {{- return $texts -}}
{{- end -}}

{{- range where .Site.Pages "Kind" "in" (slice "home" "page" "section") -}}
  {{- if and (not .Draft) .RelPermalink (ne .Params.search_index false) -}}
    {{- $pageTitle := .Title -}}
    {{- $pageUrl := .RelPermalink -}}
    {{- $pageSection := .Section -}}
    {{- if not $pageSection -}}
      {{- if .IsHome }}{{ $pageSection = "home" }}{{ else }}{{ with .File }}{{ $pageSection = .ContentBaseName }}{{ end }}{{ end -}}
    {{- end -}}
    {{- $content := partial "heading-ids.html" .Content -}}
    {{- /* Pas na heading-ids: anders tellen dubbele koppen anders dan op de
           pagina en wijzen de ankers ernaast. */ -}}
    {{- $content = replaceRE `(?s)<section data-search-index="false">.*?</section>` "" $content -}}
    {{- $chunks := split (replaceRE `<h([23]) id="` "|||HEADING|||<h${1} id=\"" $content) "|||HEADING|||" -}}
    {{- $pageText := partial "html-to-text" (index $chunks 0) -}}
    {{- $params := .Params -}}
    {{- range $extraFields -}}
      {{- with index $params (lower .) -}}
        {{- range partial "front-matter-text" . }}{{ $pageText = strings.TrimSpace (printf "%s %s" $pageText .) }}{{ end -}}
      {{- end -}}
    {{- end -}}
    {{- $pageItem := dict "title" $pageTitle "url" $pageUrl "content" $pageText "section" $pageSection -}}
    {{- with .Params.synonyms -}}
      {{- with delimit (partial "front-matter-text" .) " " }}{{ $pageItem = merge $pageItem (dict "synonyms" .) }}{{ end -}}
    {{- end -}}
    {{- $index = $index | append $pageItem -}}
    {{- range $i, $chunk := $chunks -}}
      {{- if gt $i 0 -}}
        {{- $id := replaceRE `(?s)^<h[23] id="([^"]+)".*` "$1" $chunk -}}
        {{- $heading := $chunk | replaceRE `(?s)^<h[23][^>]*>(.*?)</h[23]>.*` "$1" | plainify | htmlUnescape | strings.TrimSpace -}}
        {{- $text := partial "html-to-text" (replaceRE `(?s)^<h[23][^>]*>.*?</h[23]>` "" $chunk) -}}
        {{- /* Een kop met (bijna) geen eigen tekst, zoals een h2 direct voor een h3,
               blijft vindbaar op zijn titel; een korte tekst ("Ja.") blijft erachter. */ -}}
        {{- if le (len $text) 10 -}}{{- $text = strings.TrimSpace (printf "%s %s" $heading $text) -}}{{- end -}}
        {{- if $text -}}
          {{- $index = $index | append (dict "title" (printf "%s: %s" $pageTitle $heading) "url" (printf "%s#%s" $pageUrl $id) "content" $text "section" $pageSection) -}}
        {{- end -}}
      {{- end -}}
    {{- end -}}
    {{- /* Een uitklapblok heeft een summary, geen kop, maar mensen zoeken er wel op. */ -}}
    {{- range $block := findRE `(?s)<details id="[^"]+"[^>]*>.*?</details>` $content -}}
      {{- $id := replaceRE `(?s)^<details id="([^"]+)".*` "$1" $block -}}
      {{- $heading := $block | replaceRE `(?s)^.*?<summary[^>]*>(.*?)</summary>.*` "$1" | plainify | htmlUnescape | strings.TrimSpace -}}
      {{- $text := partial "html-to-text" (replaceRE `(?s)<summary[^>]*>.*?</summary>` "" $block) -}}
      {{- if le (len $text) 10 -}}{{- $text = strings.TrimSpace (printf "%s %s" $heading $text) -}}{{- end -}}
      {{- if $text -}}
        {{- $index = $index | append (dict "title" (printf "%s: %s" $pageTitle $heading) "url" (printf "%s#%s" $pageUrl $id) "content" $text "section" $pageSection) -}}
      {{- end -}}
    {{- end -}}
  {{- end -}}
{{- end -}}

{{- $extra := partial "search-index-extra.html" . -}}
{{- if reflect.IsSlice $extra -}}
  {{- $index = $index | append $extra -}}
{{- end -}}
{{ $index | jsonify }}
